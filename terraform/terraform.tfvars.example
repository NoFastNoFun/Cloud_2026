# Primary and DR Regions
primary_region = "eu-west-1"      # Ireland
dr_region      = "eu-central-1"   # Frankfurt
environment    = "prod"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# EC2 Configuration (Optimized for cost)
instance_type    = "t3.small"     # Reduced from t3.medium for cost savings
min_size         = 1              # Reduced from 2 for cost savings
max_size         = 2              # Keep a strict cap to protect budget
desired_capacity = 1              # Reduced from 2 for cost savings

# RDS Configuration (Optimized for cost)
db_instance_class    = "db.t3.small"  # Reduced from db.t3.medium for cost savings
db_allocated_storage = 50             # Reduced from 100GB for cost savings
db_engine_version    = "8.0"
db_name              = "prestashop"
db_username          = "admin"
db_password          = "CHANGE_ME_SECURE_PASSWORD"

# PrestaShop Configuration
prestashop_version   = "8.*"  # Latest PrestaShop 8.x
php_version          = "8.2"
prestashop_admin_email    = "admin@greenleaf.example.com"
prestashop_admin_password = "CHANGE_ME_SECURE_PASSWORD"
prestashop_domain         = ""  # Will be set to ALB DNS if empty

# Security
allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict in production
key_pair_name       = ""  # Optional: set only if the key pair already exists in AWS

# DR Configuration (Disabled by default for cost savings)
enable_dr = false  # Set to true if disaster recovery is required (~$20/month additional cost)

# EKS Configuration
enable_eks          = false
eks_cluster_name    = "greenleaf-prod-eks"
eks_cluster_version = "1.30"
eks_node_instance_types = ["t3.small"]
eks_node_capacity_type  = "SPOT"
eks_node_desired_size   = 1
eks_node_min_size       = 0
eks_node_max_size       = 1

# Kubernetes Bootstrap (run after EKS is up)
enable_k8s_bootstrap       = false
k8s_app_namespace          = "online-boutique"
k8s_observability_namespace = "observability"
k8s_enable_metrics_server  = true

# Kubernetes Autoscaling Stack (run after bootstrap)
enable_k8s_autoscaling            = false
k8s_enable_cluster_autoscaler     = true
k8s_enable_vpa                    = true
k8s_enable_vpa_resource           = false # switch to true only after first apply installs VPA CRDs
k8s_enable_hpa_demo               = true
k8s_cluster_autoscaler_chart_version = ""
k8s_vpa_chart_version             = ""
k8s_hpa_target_deployment_name    = "autoscaling-demo"

# Kubernetes Observability Stack
enable_k8s_observability          = false
k8s_enable_prometheus_stack       = true
k8s_enable_jaeger                 = true
k8s_prometheus_stack_chart_version = ""
k8s_jaeger_chart_version          = ""
k8s_prometheus_retention          = "7d"
k8s_grafana_admin_password        = ""

# CloudWatch Configuration
# Email addresses to receive CloudWatch alarm notifications
# You will receive a confirmation email for each address after deployment
cloudwatch_alarm_email_endpoints = [
  # "admin@example.com",
  # "ops-team@example.com"
]

# WAF rate limits (5-minute window, per IP)
# Test branch: values raised so load tests are not blocked by WAF rate limiting
waf_rate_limit_per_ip     = 200000
waf_alb_rate_limit_per_ip = 200000

