# Primary and DR Regions
primary_region = "eu-west-1"      # Ireland
dr_region      = "eu-central-1"   # Frankfurt
environment    = "prod"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# EC2 Configuration (Optimized for cost)
instance_type    = "t3.small"     # Reduced from t3.medium for cost savings
min_size         = 1              # Reduced from 2 for cost savings
max_size         = 6               # Can scale up when needed
desired_capacity = 1              # Reduced from 2 for cost savings

# RDS Configuration (Optimized for cost)
db_instance_class    = "db.t3.small"  # Reduced from db.t3.medium for cost savings
db_allocated_storage = 50             # Reduced from 100GB for cost savings
db_engine_version    = "8.0"
db_name              = "prestashop"
db_username          = "admin"
db_password          = "CHANGE_ME_SECURE_PASSWORD"

# PrestaShop Configuration
prestashop_version   = "8.*"  # Latest PrestaShop 8.x
php_version          = "8.2"
prestashop_admin_email    = "admin@greenleaf.example.com"
prestashop_admin_password = "CHANGE_ME_SECURE_PASSWORD"
prestashop_domain         = ""  # Will be set to ALB DNS if empty

# Security
allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict in production
key_pair_name       = "your-key-pair-name"  # Optional: for SSH access

# DR Configuration (Disabled by default for cost savings)
enable_dr = false  # Set to true if disaster recovery is required (~$20/month additional cost)

# CloudWatch Configuration
# Email addresses to receive CloudWatch alarm notifications
# You will receive a confirmation email for each address after deployment
cloudwatch_alarm_email_endpoints = [
  # "admin@example.com",
  # "ops-team@example.com"
]

