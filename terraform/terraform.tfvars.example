# Primary and DR Regions
primary_region = "eu-west-1"      # Ireland
dr_region      = "eu-central-1"   # Frankfurt
environment    = "prod"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# EC2 Configuration
instance_type    = "t3.medium"
min_size         = 2
max_size         = 6
desired_capacity = 2

# RDS Configuration
db_instance_class    = "db.t3.medium"
db_allocated_storage = 100
db_engine_version    = "8.0"
db_name              = "magento"
db_username          = "admin"
db_password          = "CHANGE_ME_SECURE_PASSWORD"

# Magento Configuration
magento_version      = "2.4.7"
php_version          = "8.2"
magento_admin_username = "admin"
magento_admin_password = "CHANGE_ME_SECURE_PASSWORD"
magento_admin_email    = "admin@greenleaf.example.com"
magento_base_url       = ""  # Will be set to ALB DNS if empty

# Security
allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict in production
key_pair_name       = "your-key-pair-name"  # Optional: for SSH access

# DR Configuration
enable_dr = true

